# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it is listed in .gitignore.

# YouTube Data API v3 (https://console.cloud.google.com/)
YOUTUBE_API_KEY=

# Reddit API (https://www.reddit.com/prefs/apps — create a "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=windows:myntra-review-discovery:v1.0 (by YourRedditUsername)

# Set to false only if HTTPS fails locally (Windows cert issues)
REVIEW_ENGINE_SSL_VERIFY=true
